# Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Model supporting Responses API web_search. Override if your project has a different model entitlement.
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=35

# Local storage and display timezone
MEMORY_DB_PATH=data/recallsearch.sqlite3
APP_TIMEZONE=Asia/Kolkata
